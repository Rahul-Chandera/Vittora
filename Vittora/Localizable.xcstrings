            "value": "आपको Vittora पर \"%1$@\" में साझा खर्च ट्रैक करने के लिए आमंत्रित किया गया है।\n\nसदस्य: %2$@\n\n%3$@\n\nVittora में खोलें: %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
