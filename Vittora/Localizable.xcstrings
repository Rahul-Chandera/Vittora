        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते %1$@, एक दोस्ताना रिमाइंडर कि %2$@ का भुगतान %3$@ तक देय है। धन्यवाद!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
