    },
    "You're invited to track shared expenses in \"%@\" on Vittora.\n\nMembers: %@\n\n%@\n\nOpen in Vittora: %@" : {
      "comment" : "A share draft message for a split group.",
      "isCommentAutoGenerated" : true,
