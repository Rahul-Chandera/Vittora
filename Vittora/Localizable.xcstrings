    "Hi %@, friendly reminder about the outstanding amount of %@. Thanks!" : {
      "comment" : "User-initiated reminder copy for debts others owe you. The first argument is the name of the payee. The second argument is the amount of the debt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hi %1$@, friendly reminder about the outstanding amount of %2$@. Thanks!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola %@, un recordatorio amable sobre el monto pendiente de %@. ¡Gracias!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते %1$@, बकाया राशि %2$@ के बारे में एक दोस्ताना रिमाइंडर। धन्यवाद!"
          }
        }
      }
    },
    "Hi %@, friendly reminder that %@ is due by %@. Thanks!" : {
