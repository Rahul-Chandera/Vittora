    "Record to Account (optional)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अकाउंट में दर्ज करें (वैकल्पिक)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar en cuenta (opcional)"
          }
        }
      }
    },
    "Recorded annual turnover of %@ exceeds the %@ GST registration threshold for services (goods: %@; special-category states: services %@ / goods %@).": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज वार्षिक टर्नओवर %@ सेवाओं के लिए GST पंजीकरण सीमा %@ से अधिक है (वस्तुएँ: %@; विशेष-श्रेणी राज्य: सेवाएँ %@ / वस्तुएँ %@)।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La facturación anual registrada de %@ supera el umbral de registro de GST de %@ para servicios (bienes: %@; estados de categoría especial: servicios %@ / bienes %@)."
          }
        }
      }
    },
    "Recorded cash business expenses of %@ in a day exceed the %@ threshold under which cash expenditure is not allowed as a deduction.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक दिन में दर्ज नकद व्यावसायिक व्यय %@ उस सीमा %@ से अधिक हैं जिसके अंतर्गत नकद व्यय कटौती के रूप में अनुमत नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos empresariales en efectivo registrados de %@ en un día superan el umbral de %@ bajo el cual el gasto en efectivo no se permite como deducción."
          }
        }
      }
    },
    "Recorded cash deposits of %@ into current accounts in this financial year meet or exceed the %@ SFT reporting threshold for current accounts.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वित्तीय वर्ष में चालू खातों में दर्ज नकद जमा %@ चालू खातों के लिए SFT रिपोर्टिंग सीमा %@ के बराबर या उससे अधिक हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los depósitos en efectivo registrados de %@ en cuentas corrientes en este año fiscal alcanzan o superan el umbral de reporte SFT de %@ para cuentas corrientes."
          }
        }
      }
    },
    "Recorded cash deposits of %@ into savings accounts in this financial year meet or exceed the %@ SFT reporting threshold for savings accounts.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वित्तीय वर्ष में बचत खातों में दर्ज नकद जमा %@ बचत खातों के लिए SFT रिपोर्टिंग सीमा %@ के बराबर या उससे अधिक हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los depósitos en efectivo registrados de %@ en cuentas de ahorro en este año fiscal alcanzan o superan el umbral de reporte SFT de %@ para cuentas de ahorro."
          }
        }
      }
    },
    "Recorded cash receipts of %@ from one person in a day meet or exceed the %@ statutory limit on receiving cash in aggregate from one person in a day.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक व्यक्ति से एक दिन में दर्ज नकद प्राप्तियाँ %@ उस दिन एक व्यक्ति से कुल नकद प्राप्त करने की वैधानिक सीमा %@ के बराबर या उससे अधिक हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recibos en efectivo registrados de %@ de una persona en un día alcanzan o superan el límite legal de %@ para recibir efectivo en conjunto de una persona en un día."
          }
        }
      }
    },
    "Recorded rent of %@ in a month exceeds the %@ monthly threshold at which tax is deductible at source on rent paid by an individual.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक महीने में दर्ज किराया %@ उस मासिक सीमा %@ से अधिक है जिस पर किसी व्यक्ति द्वारा भुगतान किए गए किराए पर स्रोत पर कर कटौती योग्य है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La renta registrada de %@ en un mes supera el umbral mensual de %@ a partir del cual se deduce impuesto en la fuente sobre renta pagada por un individuo."
          }
        }
      }
    },
