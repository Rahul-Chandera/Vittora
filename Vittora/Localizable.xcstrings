      "isCommentAutoGenerated" : true,
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे सारा वित्तीय डेटा हमेशा के लिए मिट जाएगा, सेव की गई सेटिंग हट जाएँगी और Vittora अपनी शुरुआती स्थिति में रीसेट हो जाएगा। इसे वापस नहीं किया जा सकता।"
