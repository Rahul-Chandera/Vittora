      "isCommentAutoGenerated": true,
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियम पेयी के नाम, नोट्स और रसीद में व्यापारी के टेक्स्ट के कीवर्ड से मिलान करते हैं। लंबे कीवर्ड को प्राथमिकता दी जाती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas coinciden con palabras clave en nombres de beneficiarios, notas y comercios de recibos. Las palabras clave más largas tienen prioridad."
          }
        }
      }
    },
