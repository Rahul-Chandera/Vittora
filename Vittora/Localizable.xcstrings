    "You're invited to track shared expenses in \"%@\" on Vittora.\n\nMembers: %@\n\n%@\n\nOpen in Vittora: %@": {
      "comment": "A share draft message for a split group.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You're invited to track shared expenses in \"%1$@\" on Vittora.\n\nMembers: %2$@\n\n%3$@\n\nOpen in Vittora: %4$@"
          }
        },
        "hi": {
          "stringUnit": {
