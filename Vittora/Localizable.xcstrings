          "stringUnit": {
            "state": "translated",
            "value": "सुझाया गया"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado"
          }
        }
      }
    },
    "Recomputes each account's balance from its opening balance and transaction history, then repairs any drift. Accounts that use transfers are skipped for now.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अकाउंट का बैलेंस उसके ओपनिंग बैलेंस और ट्रांज़ैक्शन हिस्ट्री से दोबारा गणना करके किसी भी अंतर को ठीक करता है। ट्रांसफ़र वाले अकाउंट अभी छोड़ दिए जाते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recalcula el saldo de cada cuenta desde su saldo inicial e historial de transacciones, y corrige cualquier desviación. Por ahora se omiten las cuentas que usan transferencias."
          }
        }
      }
    },
    "Reconciliation failed: %@": {
      "comment": "A localized error message.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलान विफल रहा: %@"
          }
