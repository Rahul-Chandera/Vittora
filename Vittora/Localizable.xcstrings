    "Nothing is sent automatically. Email goes through your own mail app, which you can edit or cancel." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía nada automáticamente. El correo pasa por su propia app de correo, que puede editar o cancelar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी अपने आप नहीं भेजा जाता। ईमेल आपके अपने मेल ऐप से जाता है, जिसे आप संपादित या रद्द कर सकते हैं।"
          }
        }
      }
    },
    "Notification permission was denied. Enable notifications in System Settings to receive reminders." : {
