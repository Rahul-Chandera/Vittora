    "The confirmation text must match exactly." : {
      "comment" : "Error message displayed when the user's input in the delete all data confirmation field does not match the required confirmation phrase.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
