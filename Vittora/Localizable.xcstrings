    "You owe %@ %lld days before the due date.": {
      "comment": "Notification body for a debt payment due reminder. The first argument is a payee name. The second argument is the number of days before the due date.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You owe %1$@ %2$lld days before the due date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देय तारीख से %2$lld दिन पहले आपको %1$@ को भुगतान करना है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted debe %@ %lld días antes de la fecha de vencimiento."
          }
        }
      }
    },
    "You're all set!": {
      "localizations": {
        "hi": {
