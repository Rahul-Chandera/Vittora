    "Vittora couldn't open its data store or create a recovery store.": {
      "comment": "Error message displayed in the startup view when Vittora couldn't open its data store or create a recovery store.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vittora अपना डेटा स्टोर नहीं खोल सका और न ही रिकवरी स्टोर बना सका।"
          }
