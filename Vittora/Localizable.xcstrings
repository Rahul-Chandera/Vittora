    },
    "OBBBA additional standard deduction for age 65+ is modeled without income phase-outs.": {
      "comment": "A warning message displayed when the user's age is 65 or older, indicating that the OBBBA additional standard deduction is not fully captured in the tax calculation.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "65+ आयु के लिए OBBBA की अतिरिक्त स्टैंडर्ड डिडक्शन की गणना आय के आधार पर चरणबद्ध कटौती के बिना की गई है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
