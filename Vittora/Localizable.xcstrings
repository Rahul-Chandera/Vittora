    "Nothing is sent automatically. Email goes through your own mail app, which you can edit or cancel.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी अपने आप नहीं भेजा जाता। ईमेल आपके अपने मेल ऐप से जाता है, जिसे आप संपादित या रद्द कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada automáticamente. El correo pasa por su propia app de correo, que puede editar o cancelar."
          }
        }
      }
    },
    "Notification permission was denied. Enable notifications in System Settings to receive reminders.": {
      "comment": "A message displayed when the user denies notification permissions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटिफ़िकेशन की अनुमति नहीं दी गई। रिमाइंडर पाने के लिए सिस्टम सेटिंग्स में नोटिफ़िकेशन चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso de notificaciones. Active las notificaciones en Ajustes del sistema para recibir recordatorios."
          }
        }
      }
    },
