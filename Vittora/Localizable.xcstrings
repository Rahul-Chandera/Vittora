    "Notifications scheduled during quiet hours are delivered when quiet hours end.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत घंटों के दौरान शेड्यूल किए गए नोटिफ़िकेशन, शांत घंटे खत्म होने पर डिलीवर होते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones programadas durante las horas de silencio se entregan cuando estas terminan."
          }
        }
