<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Vittora uses the camera to scan receipts and attach them to your transactions.</string>
	<key>NSContactsUsageDescription</key>
	<string>Vittora uses contacts to help you link people and businesses to payees and debt records.</string>
	<!-- M3.7.1: true ONLY together with com.apple.developer.financekit in
	     Vittora.entitlements. FinanceKit traps without the entitlement, and
	     iOS cannot check it at runtime. AppleWalletEntitlementTests enforces
	     that the two match. -->
	<key>VittoraFinanceKitEnabled</key>
	<false/>
	<key>NSFinancialDataUsageDescription</key>
	<string>Vittora reads the Apple Card, Apple Cash and Savings transactions you choose to import into your ledger on this iPhone. Nothing is sold or shared, and no bank login is involved.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock your private financial data on this device.</string>
	<!-- Lets the system hand a household invitation (CKShare link) to Vittora. -->
	<key>CKSharingSupported</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.enerjiktech.vittora.recurring-generation</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<!-- CloudKit silent pushes for SwiftData sync (NSPersistentCloudKitContainer). -->
		<string>remote-notification</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.enerjiktech.vittora.main</string>
		<string>com.enerjiktech.vittora.transactions</string>
		<string>com.enerjiktech.vittora.transaction</string>
		<string>com.enerjiktech.vittora.budget</string>
		<string>com.enerjiktech.vittora.report</string>
		<string>com.enerjiktech.vittora.account</string>
		<string>com.enerjiktech.vittora.transactionDraft</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.enerjiktech.vittora</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vittora</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
